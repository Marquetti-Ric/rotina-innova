    "teste:contatos": "./node_modules/.bin/esbuild testes/contatos.jsx --bundle --platform=node --format=esm --outfile=testes/c.mjs --packages=external --loader:.jsx=jsx --jsx=automatic --alias:@capacitor/app-launcher=./testes/falso-launcher.js && node testes/c.mjs",
