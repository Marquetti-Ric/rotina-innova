{
  "appId": "br.com.institutoinnova.rotina",
  "appName": "Rotina Innova",
  "webDir": "dist",
  "backgroundColor": "#F0EEDF",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#F0EEDF",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashImmersive": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#ECB70D"
    }
  },
  "android": {
    "allowMixedContent": false
  }
}
